{
  "name": "mist-isles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node ../server/index.mjs --static dist",
    "server": "node ../server/index.mjs",
    "typecheck": "tsc -b",
    "assets:prefabs": "node scripts/run-blender.mjs prefabs",
    "assets:validate": "node scripts/validate-prefabs.mjs",
    "assets:terrain": "node scripts/export-terrain.mjs && node scripts/run-blender.mjs terrain",
    "assets:terrain:export": "node scripts/run-blender.mjs terrain-export",
    "assets": "npm run assets:prefabs && npm run assets:validate && npm run assets:terrain",
    "assets:gui": "node scripts/run-blender.mjs gui",
    "world:analyze": "node scripts/analyze-world.mjs",
    "clouds:cover": "node scripts/check-cloud-cover.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
